{
  "name": "aplikasi-forum-diskusi",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Aplikasi Forum Diskusi berbasis React + Redux Toolkit dengan automation testing (Vitest, React Testing Library, Cypress) dan CI/CD.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "e2e": "start-server-and-test dev http://localhost:5173 cy:run",
    "e2e:open": "start-server-and-test dev http://localhost:5173 cy:open",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.9.0",
    "prop-types": "^15.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.63.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "cypress": "^15.21.1",
    "eslint": "^9.38.0",
    "eslint-config-dicodingacademy": "^0.9.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "^16.4.0",
    "jsdom": "^30.0.1",
    "start-server-and-test": "^3.0.12",
    "storybook": "^10.5.10",
    "vite": "^7.1.4",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "cypress@15.21.1": true,
    "fsevents@2.3.3": true
  }
}
